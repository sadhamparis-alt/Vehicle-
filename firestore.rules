rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify current user matches resource userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    // Each user can read and update only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Safeguard user accounts from arbitrary deletion
    }

    // 2. Vehicles collection
    // Isolated strictly by userId
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Expense Categories (Shared global reference or tenant-managed)
    match /expenseCategories/{categoryId} {
      allow read: if isAuthenticated();
      // Admin/system only write or user custom category handling
      allow write: if isAuthenticated();
    }

    // 4. Expense Subcategories (Shared global reference or tenant-managed)
    match /expenseSubcategories/{subcategoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Maintenance Types (Shared global reference or tenant-managed)
    match /maintenanceTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 6. Expenses collection
    // Enforces user ownership and non-tampering of userId and vehicleId
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.amount > 0
                    && request.resource.data.odometer >= 0
                    && request.resource.data.operatingHours >= 0;
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.amount > 0
                    && request.resource.data.odometer >= 0
                    && request.resource.data.operatingHours >= 0;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Maintenance Schedules collection
    match /maintenanceSchedules/{scheduleId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 8. Maintenance Records collection
    match /maintenanceRecords/{recordId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 9. Reminders collection
    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Deny all other unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
